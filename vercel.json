{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip3 install -r requirements-docs.txt",
  "buildCommand": "mkdocs build --strict",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js|svg|png|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
